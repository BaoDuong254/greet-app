{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "tauri-greet-app",
	"version": "0.1.0",
	"identifier": "com.baoduong.tauri-greet-app",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"title": "Greet App",
				"width": 800,
				"height": 600,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/greet.ico",
			"icons/icon.icns"
		]
	}
}
